# Initialize with ./scripts/init-docker-env.ps1, then use --env-file .env.docker with Compose.
DOCKER_BIND_ADDRESS=127.0.0.1
CONTAINER_BIND_ADDRESS=0.0.0.0
CONTAINER_LOOPBACK_ADDRESS=127.0.0.1
LOCAL_WEB_HOST=localhost

LOCAL_DB_HOST=postgres
LOCAL_DB_PORT=5432
LOCAL_DB_HOST_PORT=5432
LOCAL_DB_NAME=viettritutor
LOCAL_DB_USERNAME=viettri
LOCAL_DB_PASSWORD=

BACKEND_HOST=backend
BACKEND_PORT=8080
BACKEND_HOST_PORT=8080
FRONTEND_PORT=5173
FRONTEND_HOST_PORT=5173
VITE_USE_POLLING=true

# Blank secrets are generated locally by the initializer.
JWT_SECRET=

# Optional: enable pgAdmin with --profile tools.
PGADMIN_PORT=80
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Email delivery requires SMTP credentials.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
MAIL_USERNAME=
APP_GG_PASSWORD=

PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_SUCCESS=true
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_PATH=/student/checkout
VNPAY_SERVER_IP=
VNPAY_TIMEOUT_SECONDS=30
