# Copy to .env in the repository root (cp .env.example .env). Never commit .env.
# The same file is used by `docker compose up` and by scripts/start-backend.ps1.

APP_PROFILE=supabase
SERVER_PORT=8080

# --- Supabase PostgreSQL (shared team database, project ref fwoxupsupabpepgveqhr) ---
# Supabase Dashboard > Connect > "Session pooler" (port 5432, works over IPv4,
# which Docker Desktop needs). Do NOT use the transaction pooler (port 6543).
# Copy the host exactly from the dashboard; it looks like:
#   aws-0-ap-southeast-1.pooler.supabase.com
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Session pooler user is postgres.<project-ref>.
DB_USERNAME=postgres.fwoxupsupabpepgveqhr
# Ask the team lead for the password; never paste it into Git, chat logs or issues.
DB_PASSWORD=
DB_SSL_MODE=require
# Keep the pool small: every teammate's backend shares the pooler's client limit.
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1

# Use a random secret containing at least 32 bytes (e.g. `openssl rand -hex 32`).
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
MAIL_USERNAME=
APP_GG_PASSWORD=

# See Documentation/02-System-Architecture/05-VNPay-Sandbox-Setup.md.
PAYMENT_INTENT_TTL_MINUTES=5
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_SUCCESS=true
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_PATH=/student/checkout
VNPAY_SERVER_IP=
VNPAY_TIMEOUT_SECONDS=30
WALLET_TOPUP_MIN_AMOUNT=10000
WALLET_TOPUP_MAX_AMOUNT=50000000
WALLET_TOPUP_TTL_MINUTES=15
WALLET_VNPAY_RETURN_PATH=/student/wallet
VNPAY_PUBLIC_BACKEND_URL=
SERVER_FORWARD_HEADERS_STRATEGY=none

# MongoDB Atlas (LiveKit Meeting & Attendance Logs)
# Required when running in Docker: the default mongodb://localhost does not exist inside the container.
MONGODB_URI=
MONGODB_DATABASE=triviettutor

# --- Docker Compose (optional overrides; defaults shown) ---
DOCKER_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
BACKEND_HOST_PORT=8080
FRONTEND_PORT=5173
FRONTEND_HOST_PORT=5173
VITE_API_BASE_URL=/api/v1
VITE_USE_POLLING=true
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

