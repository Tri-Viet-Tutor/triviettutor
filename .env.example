# ─── Backend secrets ────────────────────────────────────────────────────────
# Copy this file to .env and fill in actual values. Never commit .env to Git.

# PostgreSQL password (must match docker-compose.yml)
DB_PASSWORD=your_database_password_here

# JWT signing secret (use a long random string, e.g. 256-bit base64)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# pgAdmin password (for local Docker only)
PGADMIN_PASSWORD=admin
