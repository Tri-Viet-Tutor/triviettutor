# Copy to .env in the project root. Never commit real credentials.
# Start: ./scripts/start-backend.ps1 -Profile supabase
# Migration history: ./scripts/migrate-database.ps1 -Action Info
# Validate/apply migrations: use -Action Validate / -Action Migrate
APP_PROFILE=supabase
SERVER_PORT=8080

# Supabase Connect > Session pooler (IPv4), or Direct (IPv6).
# Copy the exact pooler host from the dashboard, not a guessed regional host.
DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.fwoxupsupabpepgveqhr
DB_PASSWORD=replace_with_database_password
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1

# Optional separate migration credentials with DDL rights.
# When omitted, the migration runner uses DB_URL/DB_USERNAME/DB_PASSWORD.
# DB_MIGRATION_URL=jdbc:postgresql://YOUR_MIGRATION_HOST:5432/postgres?sslmode=require
# DB_MIGRATION_USERNAME=postgres
# DB_MIGRATION_PASSWORD=replace_with_migration_password

JWT_SECRET=replace_with_random_secret_of_at_least_32_characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Local Docker credentials are independent of Supabase.
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/viettritutor
LOCAL_DB_USERNAME=viettri
LOCAL_DB_PASSWORD=dev_password_change_me
PGADMIN_PASSWORD=admin

# Mock transactions also require a dev, demo, or test Spring profile.
PAYMENT_INTENT_TTL_MINUTES=15
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_SUCCESS=true
