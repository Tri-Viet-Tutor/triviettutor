# VNPay issues merchant credentials after registration. Never commit real values.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_PATH=/student/checkout
VNPAY_SERVER_IP=
VNPAY_TIMEOUT_SECONDS=30
# Public HTTPS backend origin; register its /api/v1/payments/vnpay/ipn with VNPay.
VNPAY_PUBLIC_BACKEND_URL=
PAYMENT_INTENT_TTL_MINUTES=5
PAYMENT_MOCK_ENABLED=false
# Use framework ONLY behind a trusted proxy that strips incoming forwarded headers.
SERVER_FORWARD_HEADERS_STRATEGY=none
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
