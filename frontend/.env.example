# Frontend environment variables
# Copy to .env.local and override as needed (never commit .env.local)

# Base URL for all API calls — proxied by Vite in development
VITE_API_BASE_URL=/api/v1

# Backend origin used by the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:8080

VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173
VITE_USE_POLLING=false

# Class checkout uses the backend VNPay Sandbox configuration.
# Configure VNPAY_* in the root .env; never expose merchant secrets here.

# Xem thử khi chạy `npm run dev`: mở /admin, /tutor, /student mà chưa đăng nhập thì vào bằng dữ liệu mẫu.
# Đặt false để tắt (khi đó các trang này đòi đăng nhập như bản thật). Bản build thật luôn tắt.
VITE_PREVIEW=true

# Hiện nút "Đăng nhập bằng Google" ở trang đăng nhập. Chỉ bật khi backend đã đặt GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET thật.
VITE_GOOGLE_LOGIN_ENABLED=false
