                "exec": [
                  "pm.test('Tutor login returns 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Tutor login succeeds', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.user.role).to.eql('ROLE_TUTOR');",
                  "});",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('tutorToken', json.data.accessToken);",
                  "}"
